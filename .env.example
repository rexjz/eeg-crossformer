# Dataset roots are resolved from this working directory.
DATA_DIR=./data
OUTPUT_DIR=./outputs

# Optional per-dataset overrides:
# BCIC34A_ROOT=/path/to/BCIC34a
# SEEDV_ROOT=/path/to/SEED-V
# OPENBMI_CACHE_ROOT=/path/to/OpenBMI

# OpenBMI raw recordings are managed by MNE/MOABB separately from the
# EEGCrossformer preprocessing cache at OPENBMI_CACHE_ROOT.
MNE_DATA=./data/moabb

